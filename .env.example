# Sao chép thành .env (không commit). Service role key chỉ lưu ở .env, không bao giờ đưa vào client.

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Chuỗi kết nối Postgres (Project Settings > Database), dùng cho migration/worker
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_STORAGE_BUCKET=receipts-original

# --- Queue ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
MODEL_VERSION=dev
