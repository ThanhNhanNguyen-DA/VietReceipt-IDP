# Sao chép thành .env (không commit). Service role key chỉ lưu ở .env, không bao giờ đưa vào client.

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Chuỗi kết nối Postgres, dùng cho migration/worker. Dùng **Session pooler** (Connect > Connection Method > Session pooler):
# host direct db.<ref>.supabase.co chỉ có IPv6 nên lỗi "Network is unreachable" trên WSL2/mạng IPv4.
# Mật khẩu có ký tự đặc biệt phải percent-encode.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_STORAGE_BUCKET=receipts-original

# --- Queue --- (giá trị cho chạy trên máy host; docker-compose tự ghi đè bằng hostname nội bộ redis/mlflow)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Label Studio (chỉ cho scripts/ls_setup_project.py; không dùng trong app) ---
# LS_URL=http://127.0.0.1:8080
# LS_EMAIL=
# LS_PASSWORD=

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
MODEL_VERSION=dev
